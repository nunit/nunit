<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The shared framework lists include net462, which cannot publish with NativeAOT. -->
    <!-- Multi-targeting ensures shared props see TargetFramework when setting AssemblyConfiguration. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>
    <IlcGenerateCompleteTypeMetadata>true</IlcGenerateCompleteTypeMetadata>
    <IlcTrimMetadata>false</IlcTrimMetadata>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../nunitlite/nunitlite.csproj" />
  </ItemGroup>
</Project>

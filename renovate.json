{
  "extends": [
    "github>nunit/.github"
  ],
  "packageRules": [
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": [
        "Microsoft.CodeAnalysis.CSharp",
        "Microsoft.CodeAnalysis.Analyzers",
        "Microsoft.CodeAnalysis.CSharp.CodeStyle"
      ],
      "groupName": "Roslyn"
    },
    {
      "matchManagers": ["nuget"],
      "matchPackageNames": [
        "StyleCop.Analyzers",
        "DotNetAnalyzers.DocumentationAnalyzers",
        "TunnelVisionLabs.ReferenceAssemblyAnnotator",
        "CSharpIsNullAnalyzer"
      ],
      "ignoreUnstable": false
    }
  ]
}
